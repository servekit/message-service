# =============================================================================
# message-service environment configuration
# =============================================================================
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Every ${VAR} referenced in config.example.yaml is listed below. docker-
# compose.yaml already provides safe local-dev defaults via ${VAR:-default},
# so this file mainly documents the full set and lets you override for prod
# (real DB password, SMTP / SMS credentials). docker compose auto-loads .env
# in the project dir.
#
# NOTE: compose's .env interpolation does NOT support inline `#` comments —
# keep all comments on their own line (as this file does).

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
MESSAGE_SERVICE_SERVER_GRPC_ADDR=:9000
MESSAGE_SERVICE_SERVER_HTTP_ADDR=:8080

# -----------------------------------------------------------------------------
# Database (PostgreSQL). HOST=postgres is the compose service name; use
# localhost for non-compose local dev.
# -----------------------------------------------------------------------------
MESSAGE_SERVICE_DATABASE_HOST=postgres
MESSAGE_SERVICE_DATABASE_PORT=5432
MESSAGE_SERVICE_DATABASE_USER=postgres
MESSAGE_SERVICE_DATABASE_PASSWORD=change-me
MESSAGE_SERVICE_DATABASE_DBNAME=message_service
MESSAGE_SERVICE_DATABASE_SSLMODE=disable

# -----------------------------------------------------------------------------
# Redis. ADDR=redis:6379 is the compose service name; use localhost:6379 for
# non-compose local dev.
# -----------------------------------------------------------------------------
MESSAGE_SERVICE_REDIS_ADDR=redis:6379
MESSAGE_SERVICE_REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Idempotency (shared Redis key prefix; per-channel TTLs under email/sms)
# -----------------------------------------------------------------------------
MESSAGE_SERVICE_IDEMPOTENCY_KEY_PREFIX=msg:idem

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
MESSAGE_SERVICE_LOG_LEVEL=info
MESSAGE_SERVICE_LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Email (SMTP). ACCOUNTS_0_* is the first account; add ACCOUNTS_1_* etc. to
# register more. Vendor must match an implemented email vendor (aliyun, ...).
# -----------------------------------------------------------------------------
MESSAGE_SERVICE_EMAIL_PERSISTENCE=true
MESSAGE_SERVICE_EMAIL_IDEMPOTENCY_TTL=5m
MESSAGE_SERVICE_EMAIL_ACCOUNTS_0_NAME=default
MESSAGE_SERVICE_EMAIL_ACCOUNTS_0_VENDOR=aliyun
MESSAGE_SERVICE_EMAIL_ACCOUNTS_0_HOST=smtp.example.com
MESSAGE_SERVICE_EMAIL_ACCOUNTS_0_PORT=587
MESSAGE_SERVICE_EMAIL_ACCOUNTS_0_USERNAME=replace-me
MESSAGE_SERVICE_EMAIL_ACCOUNTS_0_PASSWORD=replace-me
MESSAGE_SERVICE_EMAIL_ACCOUNTS_0_FROM=noreply@example.com
MESSAGE_SERVICE_EMAIL_ATTACHMENT_FETCH_TIMEOUT=30s

# -----------------------------------------------------------------------------
# SMS (Aliyun). To enable other vendors (tencent/volcengine/byteplus/huawei),
# uncomment their block in config.example.yaml and add the matching vars here.
# -----------------------------------------------------------------------------
MESSAGE_SERVICE_SMS_DEFAULT_COUNTRY=CN
MESSAGE_SERVICE_SMS_PERSISTENCE=true
MESSAGE_SERVICE_SMS_IDEMPOTENCY_TTL=5m
MESSAGE_SERVICE_SMS_VENDORS_ALIYUN_ACCOUNTS_0_NAME=default
MESSAGE_SERVICE_SMS_VENDORS_ALIYUN_ACCOUNTS_0_ACCESS_KEY_ID=replace-me
MESSAGE_SERVICE_SMS_VENDORS_ALIYUN_ACCOUNTS_0_ACCESS_KEY_SECRET=replace-me
MESSAGE_SERVICE_SMS_VENDORS_ALIYUN_ACCOUNTS_0_SIGN_NAME=replace-me
MESSAGE_SERVICE_SMS_VENDORS_ALIYUN_ACCOUNTS_0_REGION_ID=cn-hangzhou

# -----------------------------------------------------------------------------
# Cron
# -----------------------------------------------------------------------------
MESSAGE_SERVICE_CRON_TIMEZONE=Asia/Shanghai
MESSAGE_SERVICE_CRON_OVERLAP_POLICY=skip

# -----------------------------------------------------------------------------
# Third-party — gid-service (snowflake ID generator, module mode by default)
# -----------------------------------------------------------------------------
MESSAGE_SERVICE_THIRD_PARTY_GID_MODE=module
MESSAGE_SERVICE_THIRD_PARTY_GID_CONFIG_SNOWFLAKE_MACHINE_ID=1
MESSAGE_SERVICE_THIRD_PARTY_GID_CONFIG_SNOWFLAKE_START_TIME=2026-06-01T00:00:00Z
