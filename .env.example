# .env.example — message-service 部署环境变量模板（可选）
#
# `docker compose up` 已经在 docker-compose.yaml 里带了 ${VAR:-default}
# 兜底,零配置可起。本文件用于生产部署时覆盖默认值:
#   cp .env.example .env  →  编辑 .env 填入实际值  →  docker compose up
# docker compose 会自动加载当前目录的 .env,覆盖 yaml 里的 default。
#
# 改了 .env 不需要重启 docker-compose 之外的任何东西。

# ---- Database (生产必改 password) ----
MESSAGE_SERVICE_DATABASE_USER=postgres
MESSAGE_SERVICE_DATABASE_PASSWORD=
MESSAGE_SERVICE_DATABASE_DBNAME=message_service

# ---- Email (custom SMTP) ----
# Required for service startup:NewAccountRegistry fails fast if host is empty.
# Replace placeholders below with real SMTP credentials before deploying.
MESSAGE_SERVICE_EMAIL_VENDORS_CUSTOM_SMTP_ACCOUNTS_0_HOST=smtp.example.com
MESSAGE_SERVICE_EMAIL_VENDORS_CUSTOM_SMTP_ACCOUNTS_0_USERNAME=replace-me
MESSAGE_SERVICE_EMAIL_VENDORS_CUSTOM_SMTP_ACCOUNTS_0_PASSWORD=replace-me
MESSAGE_SERVICE_EMAIL_VENDORS_CUSTOM_SMTP_ACCOUNTS_0_FROM=noreply@example.com

# ---- SMS (Aliyun) ----
# Required for service startup. Replace placeholders with real Aliyun SMS credentials.
MESSAGE_SERVICE_SMS_VENDORS_ALIYUN_ACCOUNTS_0_ACCESS_KEY_ID=replace-me
MESSAGE_SERVICE_SMS_VENDORS_ALIYUN_ACCOUNTS_0_ACCESS_KEY_SECRET=replace-me
MESSAGE_SERVICE_SMS_VENDORS_ALIYUN_ACCOUNTS_0_SIGN_NAME=replace-me
